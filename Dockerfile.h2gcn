FROM python:3.8.20-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements-h2gcn.txt /tmp/requirements-h2gcn.txt

RUN python -m pip install --no-cache-dir 'pip==23.3.2' \
    && python -m pip install --no-cache-dir --prefer-binary \
         -r /tmp/requirements-h2gcn.txt

WORKDIR /workspace

CMD ["python", "--version"]
